# --- Frontend ---
VITE_API_URL=http://localhost:3001/api/v1

# --- Backend ---
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (SQLite local / Turso production)
DATABASE_URL=./data/unios.db
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...

# AI Provider Keys
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Pinecone (Vector DB)
PINECONE_API_KEY=
PINECONE_INDEX=unios

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Transcription
DEEPGRAM_API_KEY=